# ── AutoFlip Intelligence — backend environment ──────────────────────────────
# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=autoflip

# Auth — JWT signing secret (generate a long random string)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# CORS — comma-separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:3000

# AI damage detection (optional — feature is skipped if unset/absent)
ANTHROPIC_API_KEY=

# Stripe billing (optional)
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>
STRIPE_PRICE_MONTHLY_ID=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_YEARLY_ID=price_xxxxxxxxxxxxxxxx

# Deal-alert email (optional — SendGrid preferred, SMTP fallback)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@example.com
EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=AutoFlip Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Public URL of the frontend (used in email links)
FRONTEND_URL=http://localhost:3000
